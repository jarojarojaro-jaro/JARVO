# /srv/jarvo/compose/jarvo.env: identyfikatory Telegrama dla scripts/build.py (trasy i cele rutyn).
# To NIE są sekrety, ale nie trzymamy ich w repo.

# Twoje ID użytkownika Telegram (np. z @userinfobot). DM z botem → Jarvo; rutyny Jarva lecą tutaj.
TELEGRAM_OWNER_ID=
# ID supergrupy "Jarvo HQ" z włączonymi tematami (zaczyna się od -100…). Wątek ogólny → Jarvo.
TELEGRAM_HQ_CHAT_ID=
# ID wątków (message_thread_id) w "Jarvo HQ": link do tematu → ostatnia liczba.
TELEGRAM_TOPIC_SHERLOCK=
TELEGRAM_TOPIC_WEB=
TELEGRAM_TOPIC_STUDIO=
TELEGRAM_TOPIC_WIDEO=
TELEGRAM_TOPIC_REKA=

# Dostawca modeli całej floty (zestawy w fleet.yaml → models.presets). Puste = OpenAI (gpt-6-luna).
#   (puste)                OpenAI, logowanie ChatGPT (Models → Login): gpt-6-luna
#   openrouter             OpenRouter (Claude)
#   commandcode-anthropic  CommandCode, modele Claude
#   commandcode            CommandCode, modele otwarte (DeepSeek, Kimi)
# Klucz dostawcy dodaj w dashboardzie: Keys przy profilu „default” (trafi do wszystkich agentów).
JARVO_MODEL_PROVIDER=
# Opcjonalnie pojedyncze modele (identyfikator u wybranego dostawcy):
# JARVO_MODEL_FRONTIER=
# JARVO_MODEL_STRONG=
# JARVO_MODEL_FAST=
# JARVO_MODEL_FALLBACK=           # model zapasowy u tego samego dostawcy albo „off”
