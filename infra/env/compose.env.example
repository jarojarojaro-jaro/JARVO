# /srv/jarvo/compose/.env: konfiguracja docker compose (bez kluczy agentów; te są w /srv/jarvo/secrets/).
# Skopiuj: cp infra/env/compose.env.example /srv/jarvo/compose/.env && chmod 600 /srv/jarvo/compose/.env

# Obraz Hermesa: pusto = wersja przypięta w repo (infra/Dockerfile) i gotowy obraz floty z rejestru.
# Własny obraz albo wersja (np. nousresearch/hermes-agent:<tag>@sha256:…) = budowa obrazu floty na miejscu.
HERMES_IMAGE=
# Dodatki obrazu (spacje): rembg media docling manim office. Pusto = lekki obraz (zalecane na 8 GB).
# Dodatki Wideografa w działającym kontenerze (bez przebudowy): lemo (sample, głos Kokoro), mgaudio (muzyka kodem).
# Opis i koszt każdego: infra/python/requirements-optional.txt, docs/VPS.md
JARVO_EXTRAS=

TZ=Europe/Warsaw
JARVO_DATA=/srv/jarvo/data
JARVO_REPO=/srv/jarvo/repo
JARVO_BUILD=/srv/jarvo/build
JARVO_SECRETS=/srv/jarvo/secrets
# IP, na którym wystawiamy dashboard (9119) i panele: 127.0.0.1 albo IP Tailscale (tailscale ip -4)
JARVO_BIND_IP=127.0.0.1

# Sufit RAM/CPU kontenera Hermesa (VPS 8 GB / 4 vCPU). Na 16 GB można dać 10g i 6.
# Więcej CPU, niż ma maszyna, deploy.sh sam obniża (Docker by takiego kontenera nie uruchomił).
HERMES_MEM_LIMIT=5g
HERMES_CPUS=4

# openssl rand -hex 32
SEARXNG_SECRET=

# Logowanie do dashboardu Hermesa (http://<JARVO_BIND_IP>:9119). Hasło i sekret sesji generuje bootstrap.
DASHBOARD_USER=jarvo
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Monitoring (profil compose "monitoring"): klucz agenta Beszel z panelu huba
BESZEL_AGENT_KEY=

# Telefon testowy Twórcy aplikacji: profil compose "android" (Redroid, serwer z modułem binder) albo "android-kvm"
# (emulator Google, maszyna z /dev/kvm) + ekran ws-scrcpy. Włącza i wyłącza `jarvo android on|off` (sprawdza jądro,
# ustawia tę zmienną, startuje); ręcznie: COMPOSE_PROFILES=android albo COMPOSE_PROFILES=android-kvm.
# COMPOSE_PROFILES=android
ANDROID_CPUS=2
ANDROID_MEM_LIMIT=2g
ANDROID_EMU_MEMORY=3072
ANDROID_EMU_MEM_LIMIT=4g

# Obrazy usług przypina repo (wersja i digest w infra/docker-compose.yml). Własny obraz tylko świadomie, np.
# IMAGE_SEARXNG=searxng/searxng:<tag>@sha256:<digest> (także IMAGE_VALKEY, IMAGE_UPTIME_KUMA, IMAGE_BESZEL,
# IMAGE_BESZEL_AGENT, IMAGE_REDROID, IMAGE_ANDROID_EMULATOR); taki wpis zasłania wersje z repo.
