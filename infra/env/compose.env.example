# /srv/tars/compose/.env: konfiguracja docker compose (bez kluczy agentów; te są w /srv/tars/secrets/).
# Skopiuj: cp infra/env/compose.env.example /srv/tars/compose/.env && chmod 600 /srv/tars/compose/.env

# Obraz Hermesa: przypnij do wersji albo digestu przy pierwszym wdrożeniu (scripts/pin-images.sh)
HERMES_IMAGE=nousresearch/hermes-agent:latest
INSTALL_DOCLING=0
INSTALL_MANIM=0

TZ=Europe/Warsaw
TARS_DATA=/srv/tars/data
TARS_REPO=/srv/tars/repo
TARS_BUILD=/srv/tars/build
TARS_SECRETS=/srv/tars/secrets
# IP, na którym wystawiamy dashboard (9119) i panele: 127.0.0.1 albo IP Tailscale (tailscale ip -4)
TARS_BIND_IP=127.0.0.1

HERMES_MEM_LIMIT=10g
HERMES_CPUS=6

# openssl rand -hex 32
SEARXNG_SECRET=

# Logowanie do dashboardu Hermesa (http://<TARS_BIND_IP>:9119). Hasło i sekret sesji generuje bootstrap.
DASHBOARD_USER=tars
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# openssl rand -hex 24 (opcjonalny token API Crawl4AI)
CRAWL4AI_API_TOKEN=

# Monitoring (profil compose "monitoring"): klucz agenta Beszel z panelu huba
BESZEL_AGENT_KEY=

# Przypięte obrazy usług (wypełnia scripts/pin-images.sh)
IMAGE_SEARXNG=searxng/searxng:latest
IMAGE_VALKEY=valkey/valkey:8-alpine
IMAGE_CRAWL4AI=unclecode/crawl4ai:latest
IMAGE_GOTENBERG=gotenberg/gotenberg:8
