# /srv/jarvo/secrets/jarvo-lowca.env → /opt/data/profiles/jarvo-lowca/.env (chmod 600). Tylko sekrety.
# Osobny klucz OpenRouter dla każdego agenta z limitem kredytów (openrouter.ai → Keys → limit).
OPENROUTER_API_KEY=
# Źródła Łowcy (KRS, e-Zamówienia, TED) nie wymagają kluczy. Pauza między zapytaniami do jednego hosta
# w sekundach (domyślnie 0.25; e-Zamówienia zawsze 4):
# LOWCA_PAUZA=
