# /srv/jarvo/secrets/jarvo-lowca.env → /opt/data/profiles/jarvo-lowca/.env (chmod 600). Tylko sekrety.
# Osobny klucz OpenRouter dla każdego agenta z limitem kredytów (openrouter.ai → Keys → limit).
OPENROUTER_API_KEY=
# Źródła Łowcy (KRS, e-Zamówienia, TED) nie wymagają kluczy. Pauza między zapytaniami do jednego hosta
# w sekundach (domyślnie 0.25; e-Zamówienia zawsze 4):
# LOWCA_PAUZA=
# CEIDG (jednoosobowe działalności, ceidg.py): darmowy token API v3 Hurtowni danych CEIDG. Zdobywasz go na
# dane.biznes.gov.pl (logowanie, wniosek o dostęp, token API; kroki w docs/LEADY.md, „Token CEIDG”). Wklej sam token,
# bez „Bearer”. Zamiast tego pliku możesz go wpisać w Jarvo HQ: profil jarvo-lowca → Klucze → Własne klucze.
# Bez tokenu Łowca działa jak dotąd, tylko bez CEIDG.
CEIDG_TOKEN=
