# /srv/jarvo/secrets/jarvo-operator.env → /opt/data/profiles/jarvo-operator/.env (chmod 600). Tylko sekrety.
# Osobny klucz OpenRouter dla każdego agenta z limitem kredytów (openrouter.ai → Keys → limit).
OPENROUTER_API_KEY=
# Operator nie potrzebuje innych kluczy. Hasła do stron i paneli nie trafiają tutaj ani do czatu:
# logujesz się sam w Komputerze Jarva (Ekran HQ), a Operator korzysta z tej sesji (docs/KOMPUTER.md §7).
