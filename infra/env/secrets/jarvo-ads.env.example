# /srv/jarvo/secrets/jarvo-ads.env → /opt/data/profiles/jarvo-ads/.env (chmod 600). Tylko sekrety.
# Osobny klucz OpenRouter dla każdego agenta z limitem kredytów (openrouter.ai → Keys → limit).
OPENROUTER_API_KEY=
# Tokenów Meta i Google Ads tu NIE wpisujemy: trzyma je wyłącznie Skarbiec (osobny kontener, docs/ADS.md §2).
# Agent zna tylko adres Skarbca (domyślnie http://jarvo-skarbiec:8710); zmiana adresu:
# SKARBIEC_URL=
