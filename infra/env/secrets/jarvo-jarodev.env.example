# /srv/jarvo/secrets/jarvo-jarodev.env → /opt/data/profiles/jarvo-jarodev/.env (chmod 600). Tylko sekrety.
# Osobny klucz OpenRouter dla każdego agenta z limitem kredytów (openrouter.ai → Keys → limit).
OPENROUTER_API_KEY=
# Jarodev nie potrzebuje innych kluczy: Facebook działa na przydzielonym telefonie (jarvo telefon przydziel),
# Mapy Google w przeglądarce Komputera Jarva (bez Places API, decyzja właściciela), audyt bez kluczy.
