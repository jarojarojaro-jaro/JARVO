# /srv/tars/secrets/host.env → /opt/data/.env (profil hosta: bot Telegram, gateway). chmod 600.
TELEGRAM_BOT_TOKEN=
# Tylko Ty: DM i grupy
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_USERS=
# Grupa TARS HQ bez konieczności @wzmianki (w BotFather: /setprivacy → Disable)
TELEGRAM_REQUIRE_MENTION=false
TELEGRAM_HOME_CHANNEL=
# Klucz OpenRouter hosta (zadania pomocnicze gatewaya); osobny, z niskim limitem
OPENROUTER_API_KEY=
