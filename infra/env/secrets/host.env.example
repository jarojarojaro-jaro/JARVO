# /srv/jarvo/secrets/host.env → /opt/data/.env (profil hosta: bot Telegram, gateway). chmod 600.
TELEGRAM_BOT_TOKEN=
# Tylko Ty: DM i grupy
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_USERS=
# Grupa Jarvo HQ bez konieczności @wzmianki (w BotFather: /setprivacy → Disable)
TELEGRAM_REQUIRE_MENTION=false
# Dom Jarva (powiadomienia bramy, `deliver: telegram`): ID grupy Jarvo HQ (-100…, temat General „JARVO”), bez grupy
# Twoje ID; natywnie ustawia go `jarvo telegram tematy` / `ustaw`
TELEGRAM_HOME_CHANNEL=
# Klucz OpenRouter hosta (zadania pomocnicze gatewaya); osobny, z niskim limitem
OPENROUTER_API_KEY=
