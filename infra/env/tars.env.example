# /srv/tars/compose/tars.env: identyfikatory Telegrama dla scripts/build.py (trasy i cele rutyn).
# To NIE są sekrety, ale nie trzymamy ich w repo.

# Twoje ID użytkownika Telegram (np. z @userinfobot). DM z botem → TARS; rutyny TARS-a lecą tutaj.
TELEGRAM_OWNER_ID=
# ID supergrupy "TARS HQ" z włączonymi tematami (zaczyna się od -100…). Wątek ogólny → TARS.
TELEGRAM_HQ_CHAT_ID=
# ID wątków (message_thread_id) w "TARS HQ": link do tematu → ostatnia liczba.
TELEGRAM_TOPIC_SHERLOCK=
TELEGRAM_TOPIC_WEB=
TELEGRAM_TOPIC_STUDIO=
TELEGRAM_TOPIC_REKA=

# Dostawca modeli całej floty (zestawy w fleet.yaml → models.presets). Puste = OpenAI (gpt-6-luna).
#   (puste)                OpenAI, logowanie ChatGPT (Models → Login): gpt-6-luna
#   openrouter             OpenRouter (Claude)
#   commandcode-anthropic  CommandCode, modele Claude
#   commandcode            CommandCode, modele otwarte (DeepSeek, Kimi)
# Klucz dostawcy dodaj w dashboardzie: Keys przy profilu „default” (trafi do wszystkich agentów).
TARS_MODEL_PROVIDER=
# Opcjonalnie pojedyncze modele (identyfikator u wybranego dostawcy):
# TARS_MODEL_FRONTIER=
# TARS_MODEL_STRONG=
# TARS_MODEL_FAST=
