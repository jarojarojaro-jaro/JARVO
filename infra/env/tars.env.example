# /srv/tars/compose/tars.env: identyfikatory Telegrama dla scripts/build.py (trasy i cele rutyn).
# To NIE są sekrety, ale nie trzymamy ich w repo.

# Twoje ID użytkownika Telegram (np. z @userinfobot). DM z botem → TARS; rutyny TARS-a lecą tutaj.
TELEGRAM_OWNER_ID=
# ID supergrupy "TARS HQ" z włączonymi tematami (zaczyna się od -100…). Wątek ogólny → TARS.
TELEGRAM_HQ_CHAT_ID=
# ID wątków (message_thread_id) w "TARS HQ": link do tematu → ostatnia liczba.
TELEGRAM_TOPIC_SHERLOCK=
TELEGRAM_TOPIC_WEB=
TELEGRAM_TOPIC_STUDIO=
TELEGRAM_TOPIC_REKA=
